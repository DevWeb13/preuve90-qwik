# Public application origin used by Qwik City for URL resolution and CSRF checks.
ORIGIN=http://localhost:5173

# Server-only key. Never prefix with PUBLIC_ and never expose it to browser code.
THE_ODDS_API_KEY=replace-with-a-local-development-key

# Slug expected from The Odds API for the fixed French reference bookmaker.
# This value remains intentionally unset until the corresponding ADR is accepted.
REFERENCE_BOOKMAKER_KEY=

# Shared secret or token used by the future authenticated automation endpoint.
# The final authentication mechanism must be defined in an ADR before activation.
AUTOMATION_SECRET=replace-with-a-random-local-development-secret
