# Public application origin used by Qwik City for URL resolution and CSRF checks.
ORIGIN=http://localhost:5173

# Optional public origin used to emit absolute canonical and Open Graph URLs.
# This value is public by design and may be included in the client bundle.
PUBLIC_ORIGIN=http://localhost:5173

# Server-only key. Never prefix with PUBLIC_ and never expose it to browser code.
THE_ODDS_API_KEY=replace-with-a-local-development-key

# Fixed V1 reference. It is configuration, not a secret.
REFERENCE_BOOKMAKER_KEY=betclic_fr

# V1 has no administration endpoint and therefore no automation secret.
